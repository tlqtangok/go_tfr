# [required] your Redis server host
$redis_host = "DOMAIN_OR_IP";

# [required] your Redis server port
$redis_port = PORT;

# [optional] max file size in bytes (default: 52434944 = 50MB + 5KB)
# $max_file_sz_in_bytes = 52434944;

# [optional] max slot number, slots cycle 0~N-1 (default: 256)
# $max_jd_incr = 256;
